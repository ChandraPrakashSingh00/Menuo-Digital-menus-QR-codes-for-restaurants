# ---------------------------------------------------------------
# Menuo API configuration — copy to .env and fill in real values.
# Never commit .env. All values below are placeholders.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (see README → MongoDB Atlas setup)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/menuo?retryWrites=true&w=majority

# Long random string (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_DAYS=7

# Comma-separated list of frontend origins allowed to call the API with cookies
CLIENT_ORIGINS=http://localhost:5173

# Cookies. Development: lax + not secure (http://localhost).
# Production on the same site (app.example.com + api.example.com): lax + secure.
# Production on different sites (e.g. vercel.app + onrender.com): none + secure.
COOKIE_SAMESITE=lax
# COOKIE_SECURE defaults to true in production and false otherwise
# COOKIE_SECURE=true
# Optional, e.g. .example.com to share the cookie between subdomains
# COOKIE_DOMAIN=

# Number of reverse proxies in front of the API (Render/Railway/Heroku/Nginx: 1)
TRUST_PROXY=0

# Max JSON body size (images are sent as compressed data URLs)
JSON_BODY_LIMIT=2mb

# Billing rules
TRIAL_DAYS=7
PAYMENT_GRACE_DAYS=3
ANALYTICS_TIMEZONE=Asia/Kolkata

# Razorpay (leave empty until you have test-mode keys — checkout then returns 503)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids created in the Razorpay dashboard (Subscriptions → Plans)
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
# Number of monthly billing cycles each subscription is created for
RAZORPAY_TOTAL_COUNT=120

# Rate limits (per IP)
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
PUBLIC_RATE_LIMIT_MAX=120
